{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=working",
              "Claude Code is working"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=waiting",
              "--message-from-stdin",
              "Claude Code needs your approval"
            ]
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=waiting",
              "--message-from-stdin",
              "Claude Code needs your input"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--tokens-from-transcript",
              "--state=done",
              "Claude Code finished responding"
            ]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=error",
              "--message-from-stdin",
              "Claude Code stopped with an error"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=none",
              "Claude Code session ended"
            ]
          }
        ]
      }
    ]
  }
}
