{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=working",
              "Claude Code is working"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=waiting",
              "Claude Code needs your input"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=done",
              "Claude Code finished responding"
            ]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PARAMUX_EXECUTABLE__?RUN_INSTALL_PARAMUX_PS1",
            "args": [
              "notify",
              "--state=error",
              "Claude Code stopped with an error"
            ]
          }
        ]
      }
    ]
  }
}
