// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
#ifndef PARAMUX_COMMAND_LAUNCHER
RT_MANIFEST 24 "paramux.manifest"

#define ID_ICON_GHOSTTY 1
// GhosttyExe.zig passes an icon-content hash define so .ico-only changes
// invalidate Zig's cached resource compilation.
ID_ICON_GHOSTTY ICON "paramux.ico"
#define PARAMUX_ORIGINAL_FILENAME "paramux.exe"
#else
#define PARAMUX_ORIGINAL_FILENAME "paramux.com"
#endif

1 VERSIONINFO
FILEVERSION     PARAMUX_VERSION_MAJOR,PARAMUX_VERSION_MINOR,PARAMUX_VERSION_PATCH,PARAMUX_VERSION_REVISION
PRODUCTVERSION  PARAMUX_VERSION_MAJOR,PARAMUX_VERSION_MINOR,PARAMUX_VERSION_PATCH,PARAMUX_VERSION_REVISION
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        VALUE "CompanyName",        "Paramux Contributors"
        VALUE "FileDescription",    "Paramux terminal workspace"
        VALUE "FileVersion",        PARAMUX_VERSION_STRING
        VALUE "LegalCopyright",     "Copyright (c) Paramux contributors"
        VALUE "OriginalFilename",   PARAMUX_ORIGINAL_FILENAME
        VALUE "ProductName",        "Paramux"
        VALUE "ProductVersion",     PARAMUX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
